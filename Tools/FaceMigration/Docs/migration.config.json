  "output_policy": {
    "root": "<target_project>/Saved/FaceMigration/Jobs/{job_id}",
    "current": "Current",
    "archive": "History",
    "keep_backups_per_group": 3,
    "keep_archives": 3,
    "historical_evidence_read_only": true,
