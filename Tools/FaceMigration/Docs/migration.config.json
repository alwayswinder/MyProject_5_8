    "target.skeletal_mesh",
    "target.control_rig",
    "bindings[].role_id",
    "bindings[].max_name for enabled bindings"
  ],
  "build_order": [
    "brows",
    "eye_points",
    "upper_lids",
    "lower_lids",
    "lips",
