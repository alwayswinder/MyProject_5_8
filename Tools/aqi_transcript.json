[
 {
  "start": 0.66,
  "end": 3.46,
  "text": "我是屎李老闆的雞腿啊"
 },
 {
  "start": 4.46,
  "end": 6.26,
  "text": "嘿嘿嘿嘿"
 },
 {
  "start": 6.26,
  "end": 7.86,
  "text": "那就發達了"
 },
 {
  "start": 8.65,
  "end": 9.45,
  "text": "哎呀"
 },
 {
  "start": 9.98,
  "end": 10.58,
  "text": "啊"
 },
 {
  "start": 11.82,
  "end": 13.02,
  "text": "哦哦哦哦"
 },
 {
  "start": 13.02,
  "end": 14.42,
  "text": "要命要命要命"
 },
 {
  "start": 15.46,
  "end": 18.06,
  "text": "看什麼看沒見過不該載復活啊"
 },
 {
  "start": 18.9,
  "end": 21.1,
  "text": "不想死"
 },
 {
  "start": 22.24,
  "end": 25.64,
  "text": "超級小飛機啊"
 },
 {
  "start": 25.64,
  "end": 29.73,
  "text": "褲子要掉了"
 },
 {
  "start": 29.73,
  "end": 30.73,
  "text": "以棄預檢"
 },
 {
  "start": 35.19,
  "end": 36.79,
  "text": "分手吧見人"
 },
 {
  "start": 37.96,
  "end": 39.36,
  "text": "把兵蓋吧膽"
 },
 {
  "start": 39.36,
  "end": 42.35,
  "text": "我今天就要帶她走"
 },
 {
  "start": 42.35,
  "end": 45.35,
  "text": "我看看誰敢爛我"
 },
 {
  "start": 45.35,
  "end": 48.44,
  "text": "不想死就爛開"
 },
 {
  "start": 48.44,
  "end": 51.44,
  "text": "我是元武國的暗影刺客"
 },
 {
  "start": 51.44,
  "end": 53.92,
  "text": "不好意思 撿錯了"
 },
 {
  "start": 53.92,
  "end": 57.46,
  "text": "想偷襲我"
 },
 {
  "start": 57.46,
  "end": 59.46,
  "text": "我剛剛是怎麼了"
 },
 {
  "start": 59.46,
  "end": 62.38,
  "text": "我真是個靚仔"
 },
 {
  "start": 62.38,
  "end": 64.63,
  "text": "嗨 靚仔"
 },
 {
  "start": 64.63,
  "end": 66.63,
  "text": "要不要進來撿個頭"
 },
 {
  "start": 66.63,
  "end": 70.21,
  "text": "集中精神 以棄預檢"
 },
 {
  "start": 70.21,
  "end": 72.21,
  "text": "想不想學 可以教你"
 },
 {
  "start": 72.21,
  "end": 75.21,
  "text": "現在交錢只要五百五色十"
 },
 {
  "start": 75.21,
  "end": 77.48,
  "text": "你不说出来"
 },
 {
  "start": 77.48,
  "end": 80.08,
  "text": "对方就永远不会知道你的心意"
 },
 {
  "start": 80.08,
  "end": 82.51,
  "text": "干了一下"
 },
 {
  "start": 82.51,
  "end": 84.11,
  "text": "感觉不错"
 },
 {
  "start": 84.11,
  "end": 86.81,
  "text": "虽然我的理发技术"
 },
 {
  "start": 86.81,
  "end": 88.41,
  "text": "被村民们暂不决口"
 },
 {
  "start": 88.41,
  "end": 91.01,
  "text": "但实在是无能为力"
 },
 {
  "start": 91.01,
  "end": 93.81,
  "text": "我带你去见个医生"
 },
 {
  "start": 93.81,
  "end": 96.01,
  "text": "托顶什么的都能治好"
 },
 {
  "start": 96.01,
  "end": 99.87,
  "text": "我目前的情感状况是单身"
 },
 {
  "start": 99.87,
  "end": 102.07,
  "text": "不如一起去喝杯东西交流一下感"
 },
 {
  "start": 102.07,
  "end": 104.47,
  "text": "别走啊"
 },
 {
  "start": 104.47,
  "end": 106.67,
  "text": "喝茶记得扩我啊"
 },
 {
  "start": 106.67,
  "end": 109.2,
  "text": "我是刺客五六七"
 },
 {
  "start": 109.2,
  "end": 113.05,
  "text": "刺客旁榜17369位"
 },
 {
  "start": 113.05,
  "end": 115.97,
  "text": "很多人都会有不可告人的批号的啦"
 },
 {
  "start": 115.97,
  "end": 118.13,
  "text": "又没有去偷 又没有去抢"
 },
 {
  "start": 118.13,
  "end": 121.44,
  "text": "喜欢干什么 关别人了事啊"
 },
 {
  "start": 121.44,
  "end": 122.96,
  "text": "作为一个专业的刺客"
 },
 {
  "start": 122.96,
  "end": 124.6,
  "text": "我从来不会问原因"
 },
 {
  "start": 124.6,
  "end": 127.58,
  "text": "只问时间 地点"
 },
 {
  "start": 127.58,
  "end": 129.26,
  "text": "作为一个专业的刺客"
 },
 {
  "start": 129.26,
  "end": 132.12,
  "text": "没有什么可以拦倒我的"
 },
 {
  "start": 132.12,
  "end": 133.8,
  "text": "作为一个专业的刺客"
 },
 {
  "start": 133.8,
  "end": 136.58,
  "text": "其实上绝对不能输"
 },
 {
  "start": 136.58,
  "end": 137.74,
  "text": "对不起"
 },
 {
  "start": 137.74,
  "end": 139.58,
  "text": "有人出更高的价钱"
 },
 {
  "start": 139.58,
  "end": 141.82,
  "text": "要我来杀你"
 },
 {
  "start": 141.82,
  "end": 143.14,
  "text": "我是刺客吳樂清"
 },
 {
  "start": 143.14,
  "end": 145.94,
  "text": "刺客旁榜17369位"
 },
 {
  "start": 145.94,
  "end": 148.3,
  "text": "先任大寶追法郎高級法行師"
 },
 {
  "start": 148.3,
  "end": 149.98,
  "text": "最擅長檢空氣瀏海"
 },
 {
  "start": 149.98,
  "end": 152.06,
  "text": "一直以優質的服務和親面的價格"
 },
 {
  "start": 152.06,
  "end": 154.62,
  "text": "深受村民們的喜愛"
 },
 {
  "start": 154.62,
  "end": 156.42,
  "text": "你做我的經紀人"
 },
 {
  "start": 156.42,
  "end": 160.91,
  "text": "我要成為刺客旁榜前一百的刺客"
 },
 {
  "start": 160.91,
  "end": 162.59,
  "text": "我是一個專業的刺客"
 },
 {
  "start": 162.59,
  "end": 166.3,
  "text": "見到我你就見不到明天的太陽"
 },
 {
  "start": 166.3,
  "end": 168.3,
  "text": "這個任務這麼兼閒"
 },
 {
  "start": 168.3,
  "end": 171.03,
  "text": "是應該收你貴一點的案"
 },
 {
  "start": 171.03,
  "end": 174.82,
  "text": "你的故事真的有夠狗血"
 },
 {
  "start": 174.82,
  "end": 177.18,
  "text": "我已经不记得我过去是谁了"
 },
 {
  "start": 178.68,
  "end": 181.04,
  "text": "要我来帮你搞定你讨厌的人吧"
 },
 {
  "start": 181.28,
  "end": 182.92,
  "text": "也只收你八十八块"
 },
 {
  "start": 184.06,
  "end": 185.22,
  "text": "就算是刺客"
 },
 {
  "start": 185.78,
  "end": 187.3,
  "text": "也会有想保护的人"
 },
 {
  "start": 189.02,
  "end": 189.7,
  "text": "走啊"
 },
 {
  "start": 189.9,
  "end": 194.48,
  "text": "啊 乌鸟啊"
 },
 {
  "start": 194.6,
  "end": 195.96,
  "text": "乌鸟聊聊天吧"
 },
 {
  "start": 197.14,
  "end": 198.3,
  "text": "我是刺客五六七"
 },
 {
  "start": 198.3,
  "end": 200.7,
  "text": "先任大宝吹法郎手洗法行师"
 },
 {
  "start": 200.7,
  "end": 201.66,
  "text": "洗减吹食物"
 },
 {
  "start": 201.66,
  "end": 203.94,
  "text": "净减十块三人同行一人免单"
 },
 {
  "start": 205.21,
  "end": 206.05,
  "text": "小姐"
 },
 {
  "start": 206.05,
  "end": 207.85,
  "text": "要不要出去喝杯茶啊"
 },
 {
  "start": 207.85,
  "end": 212.46,
  "text": "要不要來一場好萊塢式的藍紫漢決鬥啊"
 },
 {
  "start": 212.46,
  "end": 216.0,
  "text": "不知道王峰那傢伙現在在幹嘛"
 },
 {
  "start": 216.0,
  "end": 218.77,
  "text": "你看人家睡得那麼舒服"
 },
 {
  "start": 218.77,
  "end": 220.77,
  "text": "你就不要打擾他啦"
 },
 {
  "start": 220.77,
  "end": 224.25,
  "text": "清蒸雞白切雞不同的做法"
 },
 {
  "start": 224.25,
  "end": 226.25,
  "text": "我都各有所愛"
 },
 {
  "start": 226.25,
  "end": 229.4,
  "text": "為什麼我沒有過去的記憶"
 },
 {
  "start": 229.4,
  "end": 232.4,
  "text": "我以前到底是一個怎麼樣的人"
 },
 {
  "start": 232.4,
  "end": 235.23,
  "text": "YA"
 },
 {
  "start": 235.23,
  "end": 236.23,
  "text": "沒有人看見吧"
 },
 {
  "start": 236.23,
  "end": 239.22,
  "text": "可惡"
 },
 {
  "start": 239.22,
  "end": 242.22,
  "text": "明天沒錢買早飯了"
 },
 {
  "start": 242.22,
  "end": 250.71,
  "text": "生日特享折扣,剪发次杀套餐只要30块"
 },
 {
  "start": 250.71,
  "end": 254.71,
  "text": "生日特享折扣,剪发次杀套餐只要30块"
 }
]