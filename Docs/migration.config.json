{
  "schema_version": 1,
  "purpose": "3ds Max facial controllers to Unreal Control Rig",
  "execution_mode": "ai_assisted_character_adaptation",
  "universal_builder_available": false,
  "path_base": "project_root",
  "entrypoints": {
    "workflow": "Docs/Workflow/Build.md",
    "methods": "Docs/Workflow/MigrationGuide.md",
    "tools": "Docs/Workflow/Tools.md",
    "validation": "Docs/Workflow/Validation.md",
    "catalog": "Docs/Reference/ControllerNames.md",
    "markdown_template": "Docs/Templates/CharacterFaceControllers.md",
    "json_template": "Docs/Templates/CharacterFaceControllers.json"
  },
  "reference_character": {
    "name": "Seven",
    "bindings": "Docs/Characters/Seven.face-controls.json",
    "status": "Docs/Characters/Seven/README.md",
    "control_rig": "/Game/_MyTest/Mouth/TMp/NewControlRigRuntimeAsset",
    "baseline_control_rig": "/Game/_MyTest/Mouth/LidDiagnostic/CR_Seven_LidWorldRotation",
    "skeletal_mesh": "/Game/_MyTest/Mouth/Mesh/Seven",
    "expected_animation_controls": 72,
    "expected_visual_cues": 1,
    "numeric_parameters_reusable_for_other_characters": false,
    "status_basis": "2026-11-09 live RuntimeAsset transfer, source-sample, reload and normal-frame preview reports in Docs/Evidence/SevenRuntime; user visual acceptance pending"
  },
  "required_input": [
    "character", "source.max_scene", "source.sample_frame",
    "target.skeletal_mesh", "target.control_rig",
    "bindings[].role_id", "bindings[].max_name for enabled bindings"
  ],
  "build_order": [
    "brows", "eye_points", "upper_lids", "lower_lids", "lips", "cheeks",
    "nose", "mouth", "eyeballs", "gaze_master", "chin", "expressions",
    "phonemes", "eye_expressions", "nose_sides"
  ],
  "recipes": {
    "brows": "Docs/Recipes/SevenBrowsAndEyes.md",
    "eye_points": "Docs/Recipes/SevenBrowsAndEyes.md",
    "upper_lids": "Docs/Troubleshooting/UpperEyelid.md",
    "lower_lids": "Docs/Recipes/XYP_LowerLids.md",
    "lips": "Docs/Recipes/LipControls.md",
    "cheeks": "Docs/Recipes/CheekControls.md",
    "nose": "Docs/Recipes/NoseControl.md",
    "mouth": "Docs/Recipes/MouthControls.md",
    "eyeballs": "Docs/Recipes/EyeballControls.md",
    "gaze_master": "Docs/Recipes/GazeMasterControl.md",
    "chin": "Docs/Recipes/ChinControl.md",
    "expressions": "Docs/Recipes/ExpressionSliders.md",
    "phonemes": "Docs/Recipes/PhonemeSliders.md",
    "eye_expressions": "Docs/Recipes/EyeExpressionSliders.md",
    "nose_sides": "Docs/Recipes/NoseSideControls.md"
  },
  "evidence": {
    "reference_root": "Docs/Evidence",
    "new_character_directory_pattern": "Docs/Evidence/{character}",
    "preserve_samples_parameters_and_regression_snapshots": true
  },
  "interaction": {
    "computer_use": false,
    "visual_acceptance": "user",
    "eye_expression_panel": "player_front_view_screen_left_near_character",
    "expression_and_phoneme_panel": "player_front_view_screen_right_near_character",
    "slider_increase": "screen_left_to_right",
    "phoneme_reference": "aligned_by_row_behind_slider_plane",
    "nose_sides": "below_overall_nose_control"
  },
  "checks": {
    "documentation": "python Scripts/validate_face_docs.py",
    "seven_live_name_coverage": "python Scripts/ue_run.py Scripts/check_face_controller_catalog.py",
    "runtime_policy": "use adapted role-specific numerical, preview-curve and save-reload checks; no blanket legacy script replay"
  }
}
